# ---- FSS-CAISSE Cloud : configuration (copier vers .env à la racine, ne JAMAIS publier ce fichier) ----

# Domaine principal : chaque établissement sera accessible sur <code>.<BASE_DOMAIN>
BASE_DOMAIN=fss-caisse.com

# Clé qui signe les sessions de connexion (32 caractères minimum, aléatoire, secrète).
# Générer avec :  openssl rand -hex 32
SESSION_SECRET=remplacer-par-une-longue-valeur-aleatoire

# Optionnel — un seul établissement sur un domaine à lui (ex. caisse.monresto.ga) :
# DEFAULT_TENANT=monresto
