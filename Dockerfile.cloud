# FSS-CAISSE Cloud — image du serveur web multi-établissements
FROM node:22-alpine
WORKDIR /srv/fss
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY sync-merge.js ./sync-merge.js
COPY app ./app
COPY cloud ./cloud
RUN rm -rf cloud/test && mkdir -p /data && chown -R node:node /data /srv/fss
USER node
ENV DATA_DIR=/data PORT=3000 INTERNAL_PORT=3001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/healthz || exit 1
CMD ["node", "cloud/server.js"]
