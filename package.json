{
  "name": "fss-caisse",
  "version": "1.10.0",
  "description": "FSS-CAISSE (Serveur ou Client)",
  "main": "main.js",
  "author": "FSS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish=never"
  },
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fss.caisse",
    "productName": "FSS-CAISSE",
    "artifactName": "FSS-CAISSE ${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "embedded-server.js",
      "printers.js",
      "afficheur.js",
      "tiroir.js",
      "licensing.js",
      "choice.html",
      "client.html",
      "acces-technicien.html",
      "serveur-injoignable.html",
      "server-ip.html",
      "activation.html",
      "app/**/*",
      "server-data/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "perMachine": true
    },
    "extraResources": [
      {
        "from": "drivers",
        "to": "drivers"
      }
    ]
  }
}
